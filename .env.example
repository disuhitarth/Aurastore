# Database
MONGODB_URI=mongodb://localhost:27017/aurastore

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google Drive API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Email Configuration (for contact forms and invoice/estimate sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@aurarenovations.ca
SMTP_PASSWORD=your-app-password

# Company Email
COMPANY_EMAIL=info@aurarenovations.ca
COMPANY_EMAIL_CC=aurarenovations.inc@gmail.com

# Domain Configuration
PRIMARY_DOMAIN=aurarenovations.ca
ALTERNATE_DOMAINS=aurarenos.ca,aurarenos.com

# Admin Credentials (Initial Setup)
ADMIN_EMAIL=info@aurarenovations.ca
ADMIN_PASSWORD=change-this-password
